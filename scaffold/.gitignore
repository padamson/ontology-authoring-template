output/
site/
book/build/

# scripts/dev.sh writes its own PID here to stop a prior loop on relaunch.
.dev.pid

# Regenerated by `mdbook-listings install` / `mdbook-admonish install` /
# `mdbook-panschema install` (see scripts/install-assets.sh)
book/mdbook-listings.css
book/mdbook-listings.js
book/mdbook-admonish.css
book/schema-link.css
book/schema-link.js

# Managed agent skills, materialized by `npx skills add`. The pin lives in
# skills-lock.json (committed); the content is fetched, like panschema's
# dependency cache, so it is not vendored here.
/.agents/
# The Claude Code entries are fetched copies, so tracking them would commit
# content the lockfile already pins. Track a skill entry only when its
# target is tracked in this repo — a skill you author here would need a `!`
# negation.
/.claude/skills/
